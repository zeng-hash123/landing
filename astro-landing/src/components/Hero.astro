---
---
<section class="relative pt-32 pb-20 md:pt-44 md:pb-32 overflow-hidden bg-[#0d0d14]">
  <!-- High-Visibility Modern Tech Square Grid Overlay -->
  <div 
    class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.12)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_85%_70%_at_50%_20%,#000_85%,transparent_100%)] pointer-events-none" 
  />
  <div 
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full bg-[linear-gradient(to_right,rgba(124,58,237,0.18)_1px,transparent_1px),linear-gradient(to_bottom,rgba(124,58,237,0.18)_1px,transparent_1px)] bg-[size:120px_120px] pointer-events-none"
  />

  <!-- Glowing Radial Backdrops -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-violet-600/20 rounded-full blur-[150px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-1/4 w-[450px] h-[450px] bg-fuchsia-500/15 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-500/15 border border-violet-500/30 text-violet-200 text-xs font-semibold mb-6 shadow-lg shadow-violet-500/10 backdrop-blur-md">
        <svg class="w-3.5 h-3.5 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
        <span>Built for Marketing Agencies & Growth Teams</span>
      </div>

      <!-- Tagline H1 (Primary SEO Headline) -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white leading-[1.1] font-sans">
        Create landing pages that convert <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-pink-400 bg-clip-text text-transparent">
          visitors into customers
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-base sm:text-lg text-gray-400 max-w-2xl mx-auto leading-relaxed font-sans">
        Multi-agent AI (copywriter, designer, compliance) generates on-brand, high-converting landing pages from a single prompt or ad URL — built specifically for agencies managing client campaigns.
      </p>

      <!-- Glassmorphic Prompt Chatbox -->
      <div class="mt-8 max-w-2xl mx-auto relative z-20">
        <form id="hero-prompt-form" class="relative bg-[#161624]/85 backdrop-blur-2xl border border-violet-500/30 rounded-2xl p-4 shadow-[0_0_50px_rgba(124,58,237,0.25)] flex flex-col group hover:border-violet-500/50 transition-all duration-300">
          <div class="flex items-start gap-2.5 w-full">
            <svg class="w-5 h-5 text-violet-400 shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <textarea
              id="hero-prompt-input"
              placeholder="Describe your landing page or paste an ad URL (e.g. AI CRM for SaaS teams)..."
              class="w-full bg-transparent text-xs sm:text-sm text-white placeholder-gray-400 focus:outline-none font-sans resize-none leading-relaxed h-28 sm:h-36 pt-0.5"
              required
            ></textarea>
          </div>
          
          <div class="flex items-center justify-between mt-3 pt-3 border-t border-white/5">
            <div class="flex items-center gap-2 text-[11px] text-gray-400 font-medium hidden sm:flex">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Multi-agent AI ready</span>
            </div>
            <button
              type="submit"
              class="ml-auto flex items-center justify-center gap-1.5 px-5 py-2 rounded-xl font-bold text-xs bg-gradient-to-r from-violet-600 via-fuchsia-500 to-pink-500 text-white shadow-lg shadow-violet-500/30 hover:opacity-95 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
            >
              <span>Generate Free</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </form>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const form = document.getElementById('hero-prompt-form');
          const input = document.getElementById('hero-prompt-input') as HTMLTextAreaElement;

          if (form) {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              const prompt = input?.value?.trim();
              if (prompt) {
                localStorage.setItem('pixelpage_initial_prompt', prompt);
              }
              const isAuth = localStorage.getItem('pixelpage_authenticated');
              if (isAuth) {
                window.location.href = '/chat';
              } else {
                window.location.href = '/auth';
              }
            });

            input?.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                form.dispatchEvent(new Event('submit', { cancelable: true }));
              }
            });
          }
        });
      </script>

      <!-- Key Value Micro-pills -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-gray-400 font-medium">
        <span class="flex items-center gap-1.5">
          <span class="text-violet-400">⚡</span> No coding required
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-fuchsia-400">🎨</span> Brand kit integration
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-emerald-400">🛡️</span> Ad compliance checked
        </span>
      </div>
    </div>

    <!-- Visual App Mockup Preview -->
    <div class="mt-14 relative mx-auto max-w-5xl rounded-2xl border border-white/10 bg-[#13131a]/80 backdrop-blur-2xl shadow-2xl p-2 sm:p-3 overflow-hidden">
      <!-- Top Browser Bar -->
      <div class="h-9 bg-[#161622] rounded-xl px-4 flex items-center justify-between border border-white/5 mb-2">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
        </div>
        <div class="px-4 py-1 rounded-lg bg-[#0d0d14] border border-white/5 text-[11px] font-mono text-gray-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          build.landing-xyx.vercel.app
        </div>
        <div class="text-xs font-semibold text-violet-400">PixelPage AI</div>
        <div class="text-xs font-semibold text-violet-400">PixelPage AI</div>
      </div>

      <!-- Interface Preview Grid -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3 bg-[#0d0d14] rounded-xl p-3 border border-white/5 min-h-[360px] md:min-h-[440px]">
        <!-- Left Chat Mockup Column -->
        <div class="md:col-span-4 bg-[#13131a] rounded-xl p-4 border border-white/5 flex flex-col justify-between space-y-4">
          <div class="text-xs font-semibold text-violet-400">PixelPage AI</div>
        <div class="text-xs text-gray-400 flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Connected to Component Library
        </div>
      </div>
      <div class="p-4 space-y-3 font-mono text-xs">
        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded-lg bg-violet-600/30 border border-violet-500/40 flex items-center justify-center text-[10px] text-violet-300 font-bold shrink-0 mt-0.5">
            AI
          </div>
          <div class="bg-[#161622] border border-white/10 p-3 rounded-2xl text-gray-300 leading-relaxed max-w-sm">
            <span class="text-violet-400 font-bold">PixelPage Assistant:</span> I've assembled a high-converting hero, features grid, compliance banner, and brand kit. Ready to preview?v>
          </div>
          <div class="p-3 rounded-xl bg-[#161622] border border-white/10 text-xs text-gray-500 flex justify-between items-center">
            <span>Ask AI to edit headline...</span>
            <span class="p-1 rounded-lg bg-violet-600 text-white">↵</span>
          </div>
        </div>

        <!-- Right Live Preview Column -->
        <div class="md:col-span-8 bg-white rounded-xl overflow-hidden p-6 text-gray-900 flex flex-col justify-between relative shadow-inner">
          <div class="space-y-4 text-center max-w-md mx-auto pt-4">
            <div class="flex items-center justify-between pb-3 border-b border-gray-100 text-xs font-medium text-gray-600">
              <span class="font-bold text-violet-600 text-sm">BrandAI</span>
              <div class="flex gap-3 text-[11px]">
                <span>Features</span>
                <span>Pricing</span>
                <span>About</span>
              </div>
            </div>
            <span class="text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full bg-violet-100 text-violet-700 inline-block mt-2">
              AI-Generated Preview
            </span>
            <h3 class="text-2xl font-bold text-gray-900 leading-tight">
              Write Cold Emails That Actually Get 40%+ Reply Rates
            </h3>
            <p class="text-xs text-gray-600">
              Powered by custom fine-tuned copywriter AI trained on $50M+ cold outreach campaigns.
            </p>
            <div class="flex justify-center gap-2 pt-2">
              <span class="px-4 py-2 rounded-lg bg-violet-600 text-white text-xs font-bold shadow-md">
                Start 14-Day Free Trial
              </span>
              <span class="px-4 py-2 rounded-lg bg-gray-100 text-gray-700 text-xs font-semibold">
                Watch Demo
              </span>
            </div>
          </div>

          <!-- Bottom Feature Badges -->
          <div class="grid grid-cols-3 gap-2 pt-6 text-center text-[10px] font-semibold text-gray-500 border-t border-gray-100 mt-6">
            <div class="p-2 bg-gray-50 rounded-lg">✓ Navbar + Hero</div>
            <div class="p-2 bg-gray-50 rounded-lg">✓ Brand Kit Synced</div>
            <div class="p-2 bg-gray-50 rounded-lg">✓ 0 Policy Flags</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
