---
const FEATURES = [
  {
    iconType: "cpu",
    title: "Multi-Agent AI Pipeline",
    description: "Specialized Copywriter, Designer, and Compliance agents run in parallel to craft copy, select layout components, and evaluate conversion structure."
  },
  {
    iconType: "palette",
    title: "Brand Kit Engine",
    description: "Upload your client's logo, primary & secondary brand colors, and custom Google Fonts to ensure every landing page stays 100% on-brand."
  },
  {
    iconType: "ab",
    title: "Built-In A/B Testing",
    description: "Automatically generate Variant A and Variant B with alternate headlines and CTA copy to double your campaign testing volume instantly."
  },
  {
    iconType: "chat",
    title: "Chat-Based Real-Time Editing",
    description: "Refine headlines, swap colors, adjust copy tone, or modify section layouts instantly using simple natural language chat commands."
  },
  {
    iconType: "shield",
    title: "Ad Compliance & Policy Checks",
    description: "Automated scan flags misleading claims, guarantees, or prohibited ad copy before you launch on Meta or Google Ads."
  },
  {
    iconType: "briefcase",
    title: "Agency White-Label Export",
    description: "Export clean, lightweight HTML/CSS code or share live previews with clients without any PixelPage branding or platform locks."
  }
];
---

<section id="features" class="py-24 bg-[#0d0d14] relative border-t border-white/5 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-extrabold uppercase tracking-widest text-violet-400">
        Engineered For Agencies
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2 font-sans">
        Everything your growth team needs to scale landing pages
      </h2>
      <p class="text-sm text-gray-400 mt-3 leading-relaxed">
        Replace fragmented design files and slow copywriter turnarounds with an integrated AI workflow.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {FEATURES.map((f) => (
        <div class="bg-[#13131a] border border-white/10 hover:border-violet-500/40 rounded-2xl p-6 transition-all duration-300 group hover:shadow-xl hover:shadow-violet-500/10">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-violet-600/20 to-fuchsia-600/10 border border-violet-500/30 flex items-center justify-center text-violet-300 mb-5 group-hover:scale-110 group-hover:border-violet-400 transition-all shadow-inner">
            {f.iconType === 'cpu' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            )}
            {f.iconType === 'palette' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4c0-1.423.91-3.374 2.163-4.75m0 0A12.012 12.012 0 0112 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-1.393 0-2.721-.284-3.927-.798m-2.91-7.454l7.1-7.1a2 2 0 112.828 2.828l-7.1 7.1" />
              </svg>
            )}
            {f.iconType === 'ab' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            )}
            {f.iconType === 'chat' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            )}
            {f.iconType === 'shield' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {f.iconType === 'briefcase' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
          </div>
          <h3 class="text-base font-bold text-white tracking-tight mb-2">
            {f.title}
          </h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            {f.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
