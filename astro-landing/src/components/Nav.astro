---
---
<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#0d0d14]/90 backdrop-blur-xl border-b border-white/10 py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="p-2 rounded-xl bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white shadow-lg shadow-violet-500/25 group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-bold text-white tracking-tight flex items-center gap-1.5 font-sans">
          Forge <span class="text-[10px] uppercase tracking-widest font-extrabold px-1.5 py-0.5 rounded-md bg-violet-500/20 text-violet-300 border border-violet-500/30">AI</span>
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-semibold text-gray-300" aria-label="Main Navigation">
      <a href="/#features" class="hover:text-white transition-colors">Features</a>
      <a href="/#how-it-works" class="hover:text-white transition-colors">How It Works</a>
      <a href="/#agencies" class="hover:text-white transition-colors">For Agencies</a>
      <a href="/blog" class="hover:text-violet-300 transition-colors text-violet-400 font-bold flex items-center gap-1">
        <span>Blog</span>
        <span class="text-[9px] px-1.5 py-0.2 rounded bg-violet-500/20 border border-violet-500/30 text-violet-300">NEW</span>
      </a>
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="/chat"
        class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/5 transition-all"
      >
        Sign In
      </a>
      <a
        href="/chat"
        class="flex items-center gap-1.5 px-4.5 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white shadow-lg shadow-violet-500/25 hover:opacity-95 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
      >
        <span>Try Forge Free</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
