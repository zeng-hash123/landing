---
---
<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#0d0d14]/90 backdrop-blur-xl border-b border-white/10 py-3.5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-xl bg-white/10 border border-white/20 p-1 flex items-center justify-center shadow-lg shadow-violet-500/20 overflow-hidden">
        <img src="/logo.jpg" alt="PixelPage Logo" class="w-full h-full object-contain rounded-lg" />
      </div>
      <span class="text-base font-bold text-white tracking-tight font-sans flex items-center gap-1.5">
        PixelPage <span class="text-[9px] sm:text-[10px] uppercase tracking-widest font-extrabold px-1.5 py-0.5 rounded-md bg-violet-500/20 text-violet-300 border border-violet-500/30">AI</span>
      </span>
    </a>

    <!-- Nav Links -->
    <div class="hidden md:flex items-center gap-8 text-xs font-medium text-gray-300">
      <a href="#features" class="hover:text-white transition-colors">Features</a>
      <a href="#how-it-works" class="hover:text-white transition-colors">How it works</a>
      <a href="#agencies" class="hover:text-white transition-colors">Agencies</a>
      <a href="/blog" class="hover:text-white transition-colors text-violet-300">Blog</a>
    </div>

    <!-- Desktop Actions -->
    <div id="nav-desktop-actions" class="hidden md:flex items-center gap-3">
      <a id="nav-signin-btn" href="/auth" class="text-xs font-semibold text-gray-300 hover:text-white transition-colors px-3 py-2">
        Sign In
      </a>
      <a
        id="nav-tryfree-btn"
        href="/chat"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white shadow-lg shadow-violet-500/25 hover:opacity-95 active:scale-95 transition-all"
      >
        <span>Try PixelPage Free</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <!-- Profile Button (Shown when logged in) -->
      <a
        id="nav-profile-btn"
        href="/chat"
        class="hidden flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-[#161624] border border-violet-500/30 text-white hover:border-violet-500/60 transition-all shadow-md group"
      >
        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-violet-600 to-fuchsia-500 flex items-center justify-center text-[10px] font-extrabold text-white shadow-sm">
          <span id="nav-user-avatar">U</span>
        </div>
        <span id="nav-user-label" class="text-xs font-semibold text-gray-200 group-hover:text-white max-w-[110px] truncate">Dashboard</span>
        <svg class="w-3.5 h-3.5 text-violet-400 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    <!-- Mobile Actions & Menu Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        id="nav-mobile-try-btn"
        href="/auth"
        class="px-3 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white shadow-md"
      >
        Try Free
      </a>
      <a
        id="nav-mobile-profile-btn"
        href="/chat"
        class="hidden flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#161624] border border-violet-500/40 text-xs font-bold text-violet-300"
      >
        <div class="w-5 h-5 rounded-full bg-violet-600 text-white text-[9px] flex items-center justify-center font-bold">
          <span id="nav-mobile-user-avatar">U</span>
        </div>
        <span>App</span>
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        class="p-2 rounded-xl text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#13131a] border-b border-white/10 px-4 py-6 space-y-4 shadow-2xl mt-3">
    <nav class="flex flex-col space-y-3.5 text-sm font-semibold text-gray-300">
      <a href="/#features" class="hover:text-white transition-colors mobile-link">Features</a>
      <a href="/#how-it-works" class="hover:text-white transition-colors mobile-link">How It Works</a>
      <a href="/#agencies" class="hover:text-white transition-colors mobile-link">For Agencies</a>
      <a href="/blog" class="hover:text-violet-300 transition-colors text-violet-400 font-bold flex items-center justify-between mobile-link">
        <span>Blog & Insights</span>
        <span class="text-[9px] px-2 py-0.5 rounded bg-violet-500/20 border border-violet-500/30 text-violet-300">NEW</span>
      </a>
    </nav>
    <div class="pt-4 border-t border-white/10 flex flex-col gap-2.5">
      <a href="/auth" class="w-full text-center py-2.5 rounded-xl text-xs font-semibold border border-white/10 text-white hover:bg-white/5">
        Sign In
      </a>
      <a href="/auth" class="w-full text-center py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white shadow-lg">
        Start Generating Free →
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (menuBtn && mobileMenu && hamburgerIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const userEmail = localStorage.getItem('pixelpage_user_email') || localStorage.getItem('forge_user_email');
    const isAuth = localStorage.getItem('pixelpage_authenticated') === 'true' || Boolean(userEmail);

    if (isAuth && userEmail) {
      const initial = userEmail.charAt(0).toUpperCase();
      const name = userEmail.split('@')[0];

      const signInBtn = document.getElementById('nav-signin-btn');
      const tryFreeBtn = document.getElementById('nav-tryfree-btn');
      const profileBtn = document.getElementById('nav-profile-btn');
      const userAvatar = document.getElementById('nav-user-avatar');
      const userLabel = document.getElementById('nav-user-label');

      const mobileTryBtn = document.getElementById('nav-mobile-try-btn');
      const mobileProfileBtn = document.getElementById('nav-mobile-profile-btn');
      const mobileUserAvatar = document.getElementById('nav-mobile-user-avatar');

      if (signInBtn) signInBtn.classList.add('hidden');
      if (tryFreeBtn) tryFreeBtn.classList.add('hidden');
      if (profileBtn) {
        profileBtn.classList.remove('hidden');
        if (userAvatar) userAvatar.textContent = initial;
        if (userLabel) userLabel.textContent = name;
      }

      if (mobileTryBtn) mobileTryBtn.classList.add('hidden');
      if (mobileProfileBtn) {
        mobileProfileBtn.classList.remove('hidden');
        if (mobileUserAvatar) mobileUserAvatar.textContent = initial;
      }
    }
  });
</script>
