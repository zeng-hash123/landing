---
---
<footer class="bg-[#0a0a0f] border-t border-white/10 text-gray-400 text-xs py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Column 1: Brand -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <div class="p-1.5 rounded-lg bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white text-xs">
            ✨
          </div>
          <span class="text-base font-bold text-white tracking-tight font-sans">
            Forge AI
          </span>
        </div>
        <p class="text-gray-400 leading-relaxed">
          Landing pages that convert visitors into customers. Multi-agent AI built for marketing agencies.
        </p>
      </div>

      <!-- Column 2: Product -->
      <div class="space-y-2">
        <h4 class="font-bold text-white uppercase tracking-wider text-[11px]">Product</h4>
        <ul class="space-y-2">
          <li><a href="/#features" class="hover:text-white transition-colors">Features</a></li>
          <li><a href="/#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
          <li><a href="/#agencies" class="hover:text-white transition-colors">For Agencies</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors text-violet-300">Blog & Insights</a></li>
        </ul>
      </div>

      <!-- Column 3: Platform -->
      <div class="space-y-2">
        <h4 class="font-bold text-white uppercase tracking-wider text-[11px]">App & Tools</h4>
        <ul class="space-y-2">
          <li><a href="/chat" class="hover:text-white transition-colors">Sign In</a></li>
          <li><a href="/chat" class="hover:text-white transition-colors">Sign Up Free</a></li>
          <li><a href="/chat" class="hover:text-white transition-colors">Generator Studio</a></li>
        </ul>
      </div>

      <!-- Column 4: Legal & Contact -->
      <div class="space-y-2">
        <h4 class="font-bold text-white uppercase tracking-wider text-[11px]">Legal</h4>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Ad Compliance Rules</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-gray-500">
      <p>© {new Date().getFullYear()} Forge AI Technologies. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-gray-300">Twitter</a>
        <a href="#" class="hover:text-gray-300">LinkedIn</a>
        <a href="#" class="hover:text-gray-300">GitHub</a>
      </div>
    </div>
  </div>
</footer>
