---
<footer class="bg-[#0a0a0f] border-t border-white/10 text-gray-400 text-xs py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Column 1: Brand -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-white/10 border border-white/20 p-1 flex items-center justify-center shadow-lg shadow-violet-500/20 overflow-hidden">
            <img src="/logo.jpg" alt="PixelPage Logo" class="w-full h-full object-contain rounded-md" />
          </div>
          <span class="text-base font-bold text-white tracking-tight font-sans">
            PixelPage AI
          </span>
        </div>
        <p class="text-gray-400 leading-relaxed">
          The multi-agent AI engine for agencies and marketers to turn prompts and ad briefs into production-ready, high-converting landing pages.
        </p>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:col-span-3">
        <div>
          <h4 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Product</h4>
          <ul class="space-y-2.5 text-xs text-gray-400">
            <li><a href="#features" class="hover:text-white transition-colors">Features</a></li>
            <li><a href="#how-it-works" class="hover:text-white transition-colors">How it works</a></li>
            <li><a href="#agencies" class="hover:text-white transition-colors">For Agencies</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Resources</h4>
          <ul class="space-y-2.5 text-xs text-gray-400">
            <li><a href="/blog" class="hover:text-white transition-colors">Blog & Guides</a></li>
            <li><a href="/blog/ad-compliance-guide-meta-google-ads" class="hover:text-white transition-colors">Ad Compliance Guide</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Legal</h4>
          <ul class="space-y-2.5 text-xs text-gray-400">
            <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-gray-500 text-xs">
      <p>&copy; {new Date().getFullYear()} PixelPage AI Technologies. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-gray-300">Twitter</a>
        <a href="#" class="hover:text-gray-300">LinkedIn</a>
        <a href="#" class="hover:text-gray-300">GitHub</a>
      </div>
    </div>
  </div>
</footer>
