---
const TESTIMONIALS = [
  {
    quote: "PixelPage allowed our agency to launch 14 client campaign pages in one week. The multi-agent copy and compliance check saved us countless hours of revision.",
    author: "Marcus Vance",
    role: "Founder & Lead Strategist",
    agency: "ScaleFlow Media",
    avatar: "MV"
  },
  {
    quote: "The brand kit integration is a game-changer. We uploaded our client's logo and primary colors, and the AI generated an on-brand page instantly.",
    author: "Sarah Chen",
    role: "Head of Performance Marketing",
    agency: "Nexus Growth Lab",
    avatar: "SC"
  },
  {
    quote: "We used the built-in A/B test variant generator for a DTC e-commerce client and saw a 34% increase in conversion rate on Day 1.",
    author: "David Miller",
    role: "Creative Director",
    agency: "Apex Conversion Agency",
    avatar: "DM"
  }
];
---

<section class="py-24 bg-[#0d0d14] relative border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-extrabold uppercase tracking-widest text-violet-400">
        Agency Success Stories
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2 font-sans">
        Loved by fast-moving marketing teams
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {TESTIMONIALS.map((t) => (
        <div class="bg-[#13131a] border border-white/10 p-6 rounded-2xl flex flex-col justify-between hover:border-white/20 transition-all shadow-xl">
          <div>
            <div class="flex gap-1 text-amber-400 mb-4 text-xs">
              ★★★★★
            </div>
            <p class="text-xs text-gray-300 leading-relaxed italic">
              "{t.quote}"
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-violet-600/20 border border-violet-500/30 text-violet-300 flex items-center justify-center font-bold text-xs">
              {t.avatar}
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">{t.author}</h4>
              <p class="text-[11px] text-gray-400">{t.role} • <span class="text-violet-400">{t.agency}</span></p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
