---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const POSTS = [
  {
    slug: "pixelpage-vs-instapage-agencies",
    title: "PixelPage vs Instapage: Which Is Better for Agencies Managing Multiple Clients?",
    excerpt: "Comparing PixelPage AI and Instapage for agencies juggling multiple client brands, budgets, and deadlines. See which platform actually speeds up delivery.",
    category: "Agency Comparisons",
    date: "July 26, 2026",
    readTime: "4 min read",
    author: "PixelPage Strategy Team",
    image: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "pixelpage-vs-unbounce-ab-testing-speed",
    title: "PixelPage vs Unbounce: A/B Testing and Speed Compared",
    excerpt: "How does PixelPage's built-in A/B variant generator stack up against Unbounce's Smart Traffic? A quick comparison for marketers who need speed and results.",
    category: "A/B Testing",
    date: "July 26, 2026",
    readTime: "4 min read",
    author: "PixelPage Strategy Team",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "best-ai-landing-page-generator-agencies",
    title: "Best AI Landing Page Generator for Marketing Agencies in 2026",
    excerpt: "Looking for the best AI landing page generator built for agencies? Here's what to look for — and why multi-agent AI is changing how client pages get built.",
    category: "AI Guide",
    date: "July 26, 2026",
    readTime: "5 min read",
    author: "PixelPage Strategy Team",
    image: "https://images.unsplash.com/photo-1542744094-3a31b272c490?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "how-to-create-high-converting-landing-page",
    title: "How to Create a High-Converting Landing Page (2026 Guide)",
    excerpt: "A practical checklist for building landing pages that convert — covering headline structure, CTA placement, trust signals, speed, and testing.",
    category: "Conversion Strategy",
    date: "July 26, 2026",
    readTime: "5 min read",
    author: "PixelPage Strategy Team",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "how-to-prompt-ai-vibecoding-landing-pages",
    title: "How to Prompt an AI Vibecoding Tool to Generate Landing Pages That Actually Convert",
    excerpt: "Vague prompts get vague landing pages. Here's how to prompt AI landing page generators like PixelPage to produce pages that actually convert.",
    category: "AI Vibecoding",
    date: "July 26, 2026",
    readTime: "5 min read",
    author: "PixelPage Strategy Team",
    image: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "how-ai-is-transforming-agency-landing-pages",
    title: "How Multi-Agent AI is Transforming Agency Landing Page Workflows",
    excerpt: "Discover how marketing agencies are using specialized copywriter, designer, and compliance AI agents to ship client pages 10x faster without developer bottlenecks.",
    category: "AI & Automation",
    date: "July 22, 2026",
    readTime: "5 min read",
    author: "PixelPage Strategy Team",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "ad-compliance-guide-meta-google-ads",
    title: "The Complete Guide to Ad Policy & Landing Page Compliance",
    excerpt: "Learn how to avoid Facebook ad account bans, Google Ads suspensions, and misleading claim penalties using automated compliance checks.",
    category: "Ad Compliance",
    date: "July 20, 2026",
    readTime: "7 min read",
    author: "PixelPage Compliance Desk",
    image: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "conversion-copywriting-frameworks-2026",
    title: "High-Converting Copywriting Frameworks for B2B SaaS & E-Commerce",
    excerpt: "A deep dive into PAS, AIDA, and BAB frameworks tailored for AI landing page generation and A/B message testing.",
    category: "Copywriting",
    date: "July 18, 2026",
    readTime: "6 min read",
    author: "PixelPage Copy Team",
    image: "https://images.unsplash.com/photo-1542744094-3a31b272c490?auto=format&fit=crop&w=800&q=80"
  }
];
---

<BaseLayout 
  title="PixelPage Blog — Landing Page Insights, AI Copywriting & Agency Growth"
  description="Expert guides on AI landing page generation, ad compliance, conversion copywriting, and scaling marketing agency workflows."
>
  <Nav />
  <main class="pt-32 pb-24 bg-[#0d0d14] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-extrabold uppercase tracking-widest text-violet-400 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20">
          Resource Hub
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mt-4 font-sans">
          The PixelPage Agency Blog
        </h1>
        <p class="text-sm text-gray-400 mt-4 leading-relaxed font-sans">
          Strategies, frameworks, and insights on landing page conversion optimization, AI workflows, and ad compliance for performance marketers.
        </p>
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {POSTS.map((post) => (
          <article class="bg-[#13131a] border border-white/10 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-violet-500/40 transition-all duration-300 shadow-xl group">
            <div>
              <div class="relative h-48 overflow-hidden bg-[#161622]">
                <img 
                  src={post.image} 
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
                />
                <span class="absolute top-3 left-3 bg-violet-600/90 text-white text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full backdrop-blur-md">
                  {post.category}
                </span>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-3 text-[11px] text-gray-400 mb-3">
                  <span>{post.date}</span>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>

                <h2 class="text-lg font-bold text-white tracking-tight mb-3 group-hover:text-violet-300 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h2>

                <p class="text-xs text-gray-400 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-white/5 mt-4 flex items-center justify-between">
              <span class="text-[11px] font-medium text-gray-400">{post.author}</span>
              <a href={`/blog/${post.slug}`} class="text-xs font-bold text-violet-400 hover:text-violet-300 flex items-center gap-1">
                <span>Read Article</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
