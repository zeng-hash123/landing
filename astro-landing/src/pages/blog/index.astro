---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const POSTS = [
  {
    slug: "how-ai-is-transforming-agency-landing-pages",
    title: "How Multi-Agent AI is Transforming Agency Landing Page Workflows",
    excerpt: "Discover how marketing agencies are using specialized copywriter, designer, and compliance AI agents to ship client pages 10x faster without developer bottlenecks.",
    category: "Agency Growth",
    date: "July 22, 2026",
    readTime: "5 min read",
    author: "PromtPage Strategy Team",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "ad-compliance-guide-meta-google-ads",
    title: "The Complete Guide to Ad Policy & Landing Page Compliance",
    excerpt: "Avoid account suspensions and rejected ads. Learn how automated compliance scanning catches misleading claims, false scarcity, and policy risks before you launch.",
    category: "Ad Compliance",
    date: "July 19, 2026",
    readTime: "7 min read",
    author: "Compliance AI Team",
    image: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=80"
  },
  {
    slug: "conversion-copywriting-frameworks-2026",
    title: "High-Converting Copywriting Frameworks for B2B SaaS & E-Commerce",
    excerpt: "Explore PAS, AIDA, and Direct-Response frameworks tuned specifically for modern AI landing page copy generation and A/B test variant creation.",
    category: "Conversion Optimization",
    date: "July 14, 2026",
    readTime: "6 min read",
    author: "Direct Response Copywriters",
    image: "https://images.unsplash.com/photo-1542744094-3a31b272c490?auto=format&fit=crop&w=800&q=80"
  }
];
---

<BaseLayout 
  title="PromtPage Blog — Landing Page Insights, AI Copywriting & Agency Growth"
  description="Actionable guides, copywriting frameworks, ad compliance rules, and AI strategies for growth agencies building client landing pages."
>
  <Nav />
  <main class="pt-32 pb-24 bg-[#0d0d14] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-extrabold uppercase tracking-widest text-violet-400">
          Agency Insights & Playbooks
        </span>
        <h1 class="text-4xl sm:text-5xl font-bold text-white tracking-tight mt-2 font-sans">
          The PromtPage Agency Blog
        </h1>
        <p class="text-sm text-gray-400 mt-4 leading-relaxed font-sans">
          Strategies, frameworks, and insights on landing page conversion optimization, AI workflows, and ad compliance for performance marketers.
        </p>
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {POSTS.map((post) => (
          <article class="bg-[#13131a] border border-white/10 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-violet-500/40 transition-all duration-300 shadow-xl group">
            <div>
              <div class="relative h-48 overflow-hidden bg-[#161622]">
                <img 
                  src={post.image} 
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
                />
                <span class="absolute top-3 left-3 bg-violet-600/90 text-white text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full backdrop-blur-md">
                  {post.category}
                </span>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-3 text-[11px] text-gray-400 mb-3">
                  <span>{post.date}</span>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>

                <h2 class="text-lg font-bold text-white tracking-tight mb-3 group-hover:text-violet-300 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h2>

                <p class="text-xs text-gray-400 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-white/5 mt-4 flex items-center justify-between">
              <span class="text-[11px] font-medium text-gray-400">{post.author}</span>
              <a href={`/blog/${post.slug}`} class="text-xs font-bold text-violet-400 hover:text-violet-300 flex items-center gap-1">
                <span>Read Article</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
