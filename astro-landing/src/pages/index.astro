---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import BuiltForAgencies from '../components/BuiltForAgencies.astro';
import Testimonials from '../components/Testimonials.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="PromtPage AI — Landing Pages That Convert Visitors Into Customers"
  description="Multi-agent AI (copywriter, designer, compliance) generates on-brand, high-converting landing pages from a single prompt or ad URL for marketing agencies."
>
  <Nav />
  <main>
    <Hero />
    <SocialProof />
    <HowItWorks />
    <FeaturesGrid />
    <BuiltForAgencies />
    <Testimonials />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
