{
  "html_template": "<section class=\"bg-white dark:bg-gray-900\">\n    <nav x-data=\"{ isOpen: false }\" class=\"container p-6 mx-auto lg:flex lg:justify-between lg:items-center\">\n        <div class=\"flex items-center justify-between\">\n            <a href=\"{{logo_url}}\">\n                <img class=\"w-auto h-6 sm:h-7\" src=\"{{logo_image_url}}\" alt=\"\">\n            </a>\n\n            <!-- Mobile menu button -->\n            <div class=\"flex lg:hidden\">\n                <button x-cloak @click=\"isOpen = !isOpen\" type=\"button\" class=\"text-gray-500 dark:text-gray-200 hover:text-gray-600 dark:hover:text-gray-400 focus:outline-none focus:text-gray-600 dark:focus:text-gray-400\" aria-label=\"toggle menu\">\n                    <svg x-show=\"!isOpen\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 8h16M4 16h16\" />\n                    </svg>\n            \n                    <svg x-show=\"isOpen\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n                    </svg>\n                </button>\n            </div>\n        </div>\n\n        <!-- Mobile Menu open: \"block\", Menu closed: \"hidden\" -->\n        <div x-cloak :class=\"[isOpen ? 'translate-x-0 opacity-100 ' : 'opacity-0 -translate-x-full']\" class=\"absolute inset-x-0 z-20 w-full px-6 py-4 transition-all duration-300 ease-in-out bg-white shadow-md lg:bg-transparent lg:dark:bg-transparent lg:shadow-none dark:bg-gray-900 lg:mt-0 lg:p-0 lg:top-0 lg:relative lg:w-auto lg:opacity-100 lg:translate-x-0 lg:flex lg:items-center\">\n            <div class=\"flex flex-col space-y-4 lg:mt-0 lg:flex-row lg:-px-8 lg:space-y-0\">\n                <a class=\"text-gray-700 transition-colors duration-300 transform lg:mx-8 dark:text-gray-200 dark:hover:text-[{{primary_color}}] hover:text-[{{primary_color}}]\" href=\"{{nav_link_1_url}}\">{{nav_link_1_text}}</a>\n                <a class=\"text-gray-700 transition-colors duration-300 transform lg:mx-8 dark:text-gray-200 dark:hover:text-[{{primary_color}}] hover:text-[{{primary_color}}]\" href=\"{{nav_link_2_url}}\">{{nav_link_2_text}}</a>\n                <a class=\"text-gray-700 transition-colors duration-300 transform lg:mx-8 dark:text-gray-200 dark:hover:text-[{{primary_color}}] hover:text-[{{primary_color}}]\" href=\"{{nav_link_3_url}}\">{{nav_link_3_text}}</a>\n                <a class=\"text-gray-700 transition-colors duration-300 transform lg:mx-8 dark:text-gray-200 dark:hover:text-[{{primary_color}}] hover:text-[{{primary_color}}]\" href=\"{{nav_link_4_url}}\">{{nav_link_4_text}}</a>\n            </div>\n\n            <a class=\"block px-5 py-2 mt-4 text-sm text-center text-white capitalize bg-[{{primary_color}}] rounded-lg lg:mt-0 hover:bg-[{{primary_color}}] lg:w-auto\" href=\"{{nav_cta_url}}\">\n                {{nav_cta_text}}\n            </a>\n        </div>\n    </nav>\n\n    <div class=\"container px-6 py-16 mx-auto text-center\">\n        <div class=\"max-w-lg mx-auto\">\n            <h1 class=\"text-3xl font-semibold text-gray-800 dark:text-white lg:text-4xl\">{{headline}}</h1>\n            <p class=\"mt-6 text-gray-500 dark:text-gray-300\">{{subheadline}}</p>\n            <button class=\"px-5 py-2 mt-6 text-sm font-medium leading-5 text-center text-white capitalize bg-[{{primary_color}}] rounded-lg hover:bg-[{{primary_color}}] lg:mx-0 lg:w-auto focus:outline-none\">\n                {{cta_text}}\n            </button>\n            <p class=\"mt-3 text-sm text-gray-400 \">{{disclaimer_text}}</p>\n        </div>\n\n        <div class=\"flex justify-center mt-10\">\n            <img class=\"object-cover w-full h-96 rounded-xl lg:w-4/5\" src=\"{{image_url}}\" />\n        </div>\n    </div>\n</section>",
  "metadata": {
    "section_type": "hero",
    "structural_approach": "top nav bar with mobile toggle, centered headline/subheadline/CTA below, large image at bottom",
