{
  "html_template": "<section class=\"bg-[{{background_color}}] dark:bg-[{{dark_background_color}}]\">\n  <div class=\"container px-6 py-10 mx-auto\">\n    <h1 class=\"text-2xl font-semibold text-center text-[{{heading_color}}] capitalize lg:text-3xl dark:text-[{{dark_heading_color}}]\">\n      {{headline}}\n    </h1>\n\n    <div class=\"flex justify-center mx-auto mt-6\">\n      <span class=\"inline-block w-40 h-1 bg-[{{primary_color}}] rounded-full\"></span>\n      <span class=\"inline-block w-3 h-1 mx-1 bg-[{{primary_color}}] rounded-full\"></span>\n      <span class=\"inline-block w-1 h-1 bg-[{{primary_color}}] rounded-full\"></span>\n    </div>\n\n    <div class=\"flex items-start max-w-6xl mx-auto mt-16\">\n      <button\n        title=\"left arrow\"\n        class=\"hidden p-2 text-[{{heading_color}}] transition-colors duration-300 border rounded-full rtl:-scale-x-100 dark:border-[{{dark_border_color}}] dark:text-[{{dark_heading_color}}] dark:hover:bg-[{{dark_hover_bg}}] lg:block hover:bg-[{{hover_bg}}]\"\n      >\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 19l-7-7 7-7\" />\n        </svg>\n      </button>\n\n      <div>\n        <p class=\"flex items-center text-center text-[{{body_color}}] lg:mx-8\">\n          {{quote_1}}\n        </p>\n\n        <div class=\"flex flex-col items-center justify-center mt-8\">\n          <img\n            class=\"object-cover rounded-full w-14 h-14\"\n            src=\"{{image_url}}\"\n            alt=\"\"\n          />\n\n          <div class=\"mt-4 text-center\">\n            <h1 class=\"font-semibold text-[{{heading_color}}] dark:text-[{{dark_heading_color}}]\">\n              {{author_1}}\n            </h1>\n\n            <span class=\"text-sm text-[{{body_color}}] dark:text-[{{dark_body_color}}]\">\n              {{author_role_1}}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      <button\n        title=\"right arrow\"\n        class=\"hidden p-2 text-[{{heading_color}}] transition-colors duration-300 border rounded-full rtl:-scale-x-100 dark:border-[{{dark_border_color}}] dark:text-[{{dark_heading_color}}] dark:hover:bg-[{{dark_hover_bg}}] lg:block hover:bg-[{{hover_bg}}]\"\n      >\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\" />\n        </svg>\n      </button>\n    </div>\n  </div>\n</section>",
